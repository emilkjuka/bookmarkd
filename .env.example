# URL you use in the browser — must match exactly, including the port (auth + form POSTs)
# Home LAN: http://192.168.1.5:3000
# NetBird:  http://100.64.0.5:3000
# Local:    http://localhost:3000
ORIGIN=http://localhost:3000

# Last resort for private Docker/home LAN if POST requests still return 403
# DISABLE_CSRF=false

# Secret used to sign auth tokens — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# SQLite database path (local dev). Docker Compose overrides this to /data/bookmarkd.db
DATABASE_URL=local.db

# Host port published by Docker Compose (optional)
BOOKMARKD_PORT=3000
