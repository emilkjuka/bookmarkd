# URL you use in the browser — must match exactly (auth cookies depend on this)
# NetBird:  http://100.64.0.5:3000  or  http://bookmarkd.netbird.cloud:3000
# Public:   https://bookmarks.example.com
# Local:    http://localhost:3000
ORIGIN=http://localhost:3000

# Secret used to sign auth tokens — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# SQLite database path (local dev). Docker Compose overrides this to /data/bookmarkd.db
DATABASE_URL=local.db

# Host port published by Docker Compose (optional)
BOOKMARKD_PORT=3000
