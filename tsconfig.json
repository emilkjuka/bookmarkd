{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true,
		"paths": {
			"#lib": ["./src/lib/index.ts"],
			"#lib/*": ["./src/lib/*"],
			"#iconify": ["./node_modules/.iconify/generated.css"],
			"#iconify-types": ["./node_modules/.iconify/generated.d.ts"]
		}
	},
	"include": ["src", "drizzle.config.ts"]
}
